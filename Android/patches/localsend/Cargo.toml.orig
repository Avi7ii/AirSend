[package]
name = "localsend"
version = "0.2.2"
edition = "2021"
license = "Apache-2.0"
description = "A rust implementation of the localsend protocol"
homepage = "https://github.com/wylited/localsend"
repository = "https://github.com/wylited/localsend"
readme = "README.md"

[dependencies]
axum = { version = "0.7.9", features = ["json", "macros", "tokio"] }
axum-macros = "0.4.2"
base64 = "0.22.1"
chrono = "0.4.39"
hyper = { version = "1.8.1", features = ["server", "http1", "http2"] }
hyper-util = { version = "0.1.20", features = ["server", "tokio", "http1", "http2", "service"] }
mime = "0.3.17"
mime_guess = "2.0.5"
native-dialog = "0.7.0"
reqwest = { version = "0.12.9", features = ["json"] }
socket2 = "0.6.2"
rustls = { version = "0.23.36", default-features = false, features = ["ring", "std", "tls12"] }
serde = { version = "1.0.216", features = ["derive"] }
serde_json = "1.0.133"
sha256 = "1.5.0"
thiserror = "2.0.6"
tokio = "1.42.0"
tokio-rustls = { version = "0.26.4", default-features = false, features = ["ring", "tls12"] }
tower = { version = "0.5.3", features = ["util"] }
tower-http = { version = "0.6.2", features = ["limit"] }
uuid = { version = "1.11.0", features = ["v4", "fast-rng"] }
